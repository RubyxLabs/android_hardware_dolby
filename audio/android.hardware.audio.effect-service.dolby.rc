service vendor.audio-effect-dolby /vendor/bin/hw/android.hardware.audio.effect-service.dolby
    class hal
    user audioserver
    group audio media mediadrm
    capabilities SYS_NICE
    rlimit rtprio 10 10
    ioprio rt 4
    task_profiles ProcessCapacityHigh HighPerformance
    onrestart restart vendor.audio-hal
