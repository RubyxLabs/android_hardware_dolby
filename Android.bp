soong_namespace {}

// Private v33 symbols keep legacy AHandler/ALooper objects out of the current
// platform foundation ABI, including calls made from the compatibility DSO.
cc_prebuilt_library_shared {
    name: "libstagefright_foundation_dolby",
    vendor: true,
    compile_multilib: "64",
    strip: {
        none: true,
    },
    srcs: ["proprietary/vendor/lib64/libstagefright_foundation_dolby.so"],
    shared_libs: [
        "libc++",
        "libcutils",
        "liblog",
        "libutils",
        "libc",
        "libm",
        "libdl",
    ],
}

